{
  "name": "@robot-inventor/oxlint-config",
  "version": "0.3.0",
  "description": "My Oxlint config preset",
  "homepage": "https://github.com/Robot-Inventor/oxlint-config#readme",
  "bugs": {
    "url": "https://github.com/Robot-Inventor/oxlint-config/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Robot-Inventor/oxlint-config.git"
  },
  "license": "MIT",
  "author": "Robot-Inventor",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc",
    "lint": "tsc && oxlint src oxlint.config.ts",
    "format": "prettier --write \"src/**/*.ts\" oxlint.config.ts",
    "format:check": "prettier --check \"src/**/*.ts\" oxlint.config.ts",
    "ci:version": "changeset version",
    "ci:publish": "npm run build && changeset publish"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@robot-inventor/tsconfig-base": "^7.2.0",
    "prettier": "^3.9.8",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@next/eslint-plugin-next": "^16.3.5",
    "eslint": "^10.11.0",
    "eslint-import-resolver-node": "^0.4.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsdoc": "^64.5.4",
    "oxlint": "^1.83.0",
    "oxlint-plugin-react-doctor": "^0.9.14",
    "oxlint-tsgolint": "^7.0.2002"
  }
}
