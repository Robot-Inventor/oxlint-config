{
  "name": "@robot-inventor/oxlint-config",
  "version": "0.5.2",
  "description": "My Oxlint config preset",
  "homepage": "https://github.com/Robot-Inventor/oxlint-config#readme",
  "bugs": {
    "url": "https://github.com/Robot-Inventor/oxlint-config/issues"
  },
  "license": "MIT",
  "author": "Robot-Inventor",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Robot-Inventor/oxlint-config.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "tsc --noEmit && knip-bun && oxlint src oxlint.config.ts",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "ci:version": "changeset version",
    "ci:publish": "npm run build && changeset publish"
  },
  "dependencies": {
    "@next/eslint-plugin-next": "^16.4.3",
    "@oxlint/plugins": "^1.89.0",
    "eslint": "^10.13.0",
    "eslint-import-resolver-node": "^0.4.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsdoc": "^65.4.2",
    "oxlint": "^1.89.0",
    "oxlint-plugin-react-doctor": "^0.9.18",
    "oxlint-tsgolint": "^7.0.2005"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@robot-inventor/tsconfig-base": "^7.2.0",
    "knip": "^6.43.0",
    "oxfmt": "^0.74.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
